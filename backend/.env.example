# Model 1 - sign recognition: mock | keras
RECOGNIZER=mock
MODEL_PATH=models/sign_model.keras
LABELS_PATH=models/labels.json
MODEL_CONFIG_PATH=models/model_config.json
MOCK_SCRIPT=I GO SCHOOL | MY MOTHER TEACHER | HELLO NAME WHAT

# Words below this confidence are dropped, never guessed
CONFIDENCE_THRESHOLD=0.6

# Model 2 - sentence builder: rule | groq | hf
SENTENCE_BUILDER=rule
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
HF_BASE_MODEL=
HF_ADAPTER_PATH=

# Partner API keys (comma separated). Empty = open (demo)
API_KEYS=
CORS_ORIGINS=*
